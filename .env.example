APP_NAME="Ulvi Case Study"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# The demo page sends several requests at once.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required. `docker compose up -d` starts one with these values.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ulvi_case_study
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (WebSockets), local values.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ulvi-local
REVERB_APP_KEY=ulvi-local-key
REVERB_APP_SECRET=ulvi-local-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# "fake" needs no API key. "anthropic" calls Claude.
REPLY_DRIVER=fake
FAKE_REPLY_LATENCY_MS=1500
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# "fake" runs checkout locally. "stripe" uses Stripe test mode.
PAYMENT_GATEWAY=fake
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=whsec_local_development_only

